APP_ENV=development
RUST_LOG=info
HTTP_ADDR=0.0.0.0:8080
HOST_HTTP_PORT=8080
# Linux: set these to the output of id -u and id -g before building.
LOCAL_UID=1000
LOCAL_GID=1000

# Local development only; do not reuse these credentials in production.
POSTGRES_DB=reliable_event_relay
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Replace placeholders in ignored .env; enter these same values in the browser.
RABBITMQ_DEFAULT_USER=change_me
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_DEFAULT_VHOST=relay
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_CONNECT_TIMEOUT_MS=10000
RABBITMQ_PUBLISH_TIMEOUT_MS=10000
RABBITMQ_EXCHANGE=relay.events
RABBITMQ_QUEUE=relay.local
RABBITMQ_ROUTING_KEY=event

# Relay worker (milliseconds except pool size); schema rollout is explicit.
RELAY_LEASE_MS=60000
RELAY_IDLE_MS=1000
RELAY_FAILURE_MS=1000
RELAY_RECONNECT_MS=5000
RELAY_POOL_MAX=2
RELAY_POOL_ACQUIRE_MS=5000
RELAY_STATEMENT_MS=5000
RELAY_LOCK_MS=3000
RELAY_DRAIN_MS=15000
RELAY_SHUTDOWN_MS=25000

# Frontend development host loopback port (container 5173).
HOST_FRONTEND_PORT=5173

# Optional, at most 32 independently observed UUID:cycle:revision entries, comma-separated.
# Each is attempted once per worker run; remove stale entries before restarting.
RELAY_MAINTENANCE_CANDIDATES=

# Optional privileged operator credentials; empty disables replay routes.
# See docs/en/operations/replay.md. Never put credentials in VITE_* variables.
REPLAY_OPERATORS=

# Consumer autostarts after the authorized 4.5 rollout; preserve intentional stops.
# Use named Supervisor controls; manager recreation may resume consumption.
CONSUMER_NAME=inventory.stock.v1
CONSUMER_PREFETCH=1
CONSUMER_SOURCE_EXCHANGE=relay.events
CONSUMER_SOURCE_QUEUE=relay.local
CONSUMER_SOURCE_ROUTING_KEY=event
CONSUMER_QUARANTINE_EXCHANGE=relay.quarantine
CONSUMER_QUARANTINE_QUEUE=relay.quarantine.inventory
CONSUMER_QUARANTINE_ROUTING_KEY=inventory
CONSUMER_OPERATION_MS=10000
CONSUMER_RECONNECT_MS=5000
CONSUMER_DRAIN_MS=15000
CONSUMER_SHUTDOWN_MS=25000
CONSUMER_POOL_MAX=2
CONSUMER_POOL_ACQUIRE_MS=5000
CONSUMER_STATEMENT_MS=5000
CONSUMER_LOCK_MS=3000

# Separate process-local exporters, loopback only; all ports distinct from HTTP.
# Inspect inside app; deliberately not published on the Docker host.
HTTP_METRICS_ADDR=127.0.0.1:9100
RELAY_METRICS_ADDR=127.0.0.1:9101
CONSUMER_METRICS_ADDR=127.0.0.1:9102

# Main application demo authentication. Generated once by scripts/start-local.py.
# Keep it private; enter it at runtime in the modal. Never use VITE_* for secrets.
DEMO_TOKEN=
