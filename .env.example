APP_ENV=development
RUST_LOG=info
HTTP_ADDR=0.0.0.0:8080
HOST_HTTP_PORT=8080
# Linux: set these to the output of id -u and id -g before building.
LOCAL_UID=1000
LOCAL_GID=1000

# Local development only; do not reuse these credentials in production.
POSTGRES_DB=reliable_event_relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
